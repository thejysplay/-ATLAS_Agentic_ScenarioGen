# Copy to .env and fill in. Only LLM calls (agent execution + scenario generation) use these.
GEMINI_API_KEY=your-gemini-api-key

# External benchmark checkouts (clone separately; not vendored here)
AGENTDOJO_REPO=/path/to/agentdojo
AGENTDYN_REPO=/path/to/agentdyn
APPWORLD_ROOT=/path/to/appworld

# Optional: override output location (defaults to this repo)
# SPECTRA_OUT=/path/to/output
